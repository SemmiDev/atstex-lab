# ╔══════════════════════════════════════════════════════════════╗
# ║  ATSTEX-LAB Docker Compose (App) — Managed by Ansible       ║
# ╚══════════════════════════════════════════════════════════════╝

services:
  atstex-lab:
    build:
      context: "{{ app_dir }}/src"
      dockerfile: Dockerfile
    image: {{ app_name }}:latest
    container_name: {{ app_name }}
    restart: unless-stopped
    ports:
      - "127.0.0.1:{{ app_port }}:8080"
    env_file:
      - "{{ app_dir }}/src/.env"
    networks:
      - atstex_network
    tmpfs:
      - /tmp:size={{ docker_tmpfs_size }},mode=1777
    mem_limit: {{ docker_memory_limit }}
    cpus: {{ docker_cpu_limit }}
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://127.0.0.1:8080/"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

networks:
  atstex_network:
    external: true
