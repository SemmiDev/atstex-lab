# AI Extraction Config
AI_PROVIDER={{ ai_provider }}
AI_MODEL={{ ai_model }}
AI_API_KEY={{ ai_api_key }}
{% if ai_base_url is defined and ai_base_url %}
AI_BASE_URL={{ ai_base_url }}
{% endif %}
